{
  "name": "sportbar-siruch-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:local": "node dev-server.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "pages:create": "wrangler pages project create tenissiruch --production-branch main",
    "pages:deploy": "npm run build:pages && wrangler pages deploy dist --project-name tenissiruch --branch main --commit-dirty=true",
    "pages:deploy:direct": "npm run build:pages && node scripts/deploy-pages-direct.mjs",
    "v2:dev": "wrangler dev --config wrangler.v2.jsonc --port 8788",
    "v2:seed": "node scripts/seed-v2-local.mjs",
    "v2:migrate:production": "wrangler d1 migrations apply tenissiruch_portal --remote --config wrangler.production.jsonc",
    "v2:deploy:production": "wrangler deploy --config wrangler.production.jsonc",
    "v2:deploy:direct": "node scripts/deploy-worker-content-direct.mjs",
    "v2:typegen": "wrangler types worker-v2/worker-configuration.d.ts --config wrangler.v2.jsonc --env-interface CloudflareBindings",
    "v2:typecheck": "tsc --project tsconfig.v2.json --noEmit",
    "v2:test": "vitest run --config vitest.v2.config.ts",
    "test:ops": "node --test --test-isolation=none test/ops/*.test.mjs",
    "v2:check": "npm run test:ops && npm run v2:typegen && npm run v2:typecheck && npm run v2:test && wrangler deploy --dry-run --config wrangler.v2.jsonc",
    "v2:smoke": "node scripts/smoke-v2.mjs",
    "v2:smoke:roles": "node scripts/smoke-roles-v2.mjs",
    "v2:smoke:lineups": "node scripts/smoke-reservation-lineups-v2.mjs",
    "db:backup": "node scripts/backup-d1.mjs",
    "db:restore": "node scripts/restore-d1.mjs",
    "club:provision": "node scripts/provision-club.mjs",
    "club:plan": "node scripts/provision-club.mjs --plan",
    "club:install": "node scripts/install-club.mjs",
    "release:v2": "node scripts/release-v2.mjs",
    "cf:login": "wrangler login",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:d1:create": "wrangler d1 create sportbar_siruch_portal",
    "cf:d1:migrate:local": "wrangler d1 migrations apply sportbar_siruch_portal --local",
    "cf:d1:migrate": "wrangler d1 migrations apply sportbar_siruch_portal --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "undici": "^7.29.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "hono": "^4.13.0"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
